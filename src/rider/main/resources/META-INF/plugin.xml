<idea-plugin require-restart="true">
  <id>local.bathur.resharper.mcp.toolset</id>
  <name>ReSharper MCP Toolset</name>
  <version>0.3.10</version>
  <vendor>Bathur</vendor>
  <resource-bundle>messages.ReSharperMcpToolsetBundle</resource-bundle>
  <idea-version since-build="262.10315.191" until-build="262.10315.191" />

  <depends>com.intellij.modules.rider</depends>
  <depends>com.intellij.modules.rider.cpp.core</depends>
  <depends>com.intellij.mcpServer</depends>

  <extensions defaultExtensionNs="com.intellij">
    <mcpServer.mcpToolset implementation="local.bathur.resharper.mcp.toolset.ReSharperMcpToolset" />
    <advancedSetting id="local.bathur.resharper.mcp.toolset.failure.logging"
                     default="false"
                     groupKey="group.advanced.settings.resharper.mcp.toolset" />
  </extensions>

  <description><![CDATA[
    <p>ReSharper C++ semantic tools and explicit existing-file project registration exposed through Rider's built-in MCP server.</p>
  ]]></description>
</idea-plugin>
